# The agent service: one analyst query through the copilot's graph.
#
# This image DOES carry the heavy stack - `torch`, `chromadb`, `anthropic`, `langgraph`,
# `sentence-transformers` - because the copilot embeds a query and searches an index. It is
# the whole reason the model service is a separate image: about 604 MB of dependency that a
# request for `P(default)` would otherwise pay for and never call.
#
# **`torch` resolves against the CPU-only wheel index**, declared in `pyproject.toml`. On
# Linux the default wheel drags 19 CUDA and NVIDIA packages that nothing here calls - the
# embedding model runs on CPU - and they are not small: measured against the published
# wheels, 2,596.5 MB of Linux wheel bytes removed against 182.9 MB added back by
# `torch==2.13.0+cpu`. **The builder therefore needs network access to
# download.pytorch.org**, not only to PyPI; a build behind a proxy that allows one and not
# the other fails at the sync step with a resolution error and not with a timeout.
#
# The only difference from `Dockerfile.model` is `--group agent` in the sync, and that is
# deliberate: one difference is auditable, and two files that drift apart are not.
#
# Build from the repository root so `.dockerignore` applies:
#     docker build -f docker/Dockerfile.agent -t credit-risk-agent .

ARG PYTHON_VERSION=3.11-slim-bookworm

# ---------------------------------------------------------------------------
# Stage 1 - build the virtual environment
# ---------------------------------------------------------------------------
FROM python:${PYTHON_VERSION} AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.0 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

COPY pyproject.toml uv.lock ./

# `--group agent` is the one line that separates this image from the model's.
# `--no-default-groups` comes first and is not redundant: `tool.uv.default-groups` marks
# `dev`, `agent` and `research` as default so that a contributor's `uv sync` gives a complete
# environment, and an image has to opt out of exactly that convenience.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-default-groups --group agent

# ---------------------------------------------------------------------------
# Stage 2 - the runtime
# ---------------------------------------------------------------------------
FROM python:${PYTHON_VERSION} AS runtime

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:${PATH}" \
    PYTHONPATH=/app/src \
    AGENT_API_PORT=8001

# Keep the embedding model's cache inside the user's home rather than in whatever directory
# the library picks by default. A non-root process that cannot write its cache fails at first
# use with a permission error about a path nobody configured, which reads as a bug in the
# copilot rather than as a missing directory.
ENV HF_HOME=/home/app/.cache/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/home/app/.cache/sentence-transformers

WORKDIR /app

COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv
COPY --chown=10001:10001 src/ /app/src/

# **Why the corpus and the index are mounted and not copied.**
# `data/vector_store/` is derived data: it is gitignored and rebuilt by
# `scripts/build_rag_index.py`. Baking it in would put a build artefact of one pipeline into
# the image of another, and would make a re-index a reason to rebuild and republish an image.
# The corpus is small and versioned, so copying *it* would be defensible on its own - and it
# is mounted anyway, because the index and the corpus must be the same revision. A chunk
# identifier resolved against a corpus the index was not built from returns the wrong
# fragment with no error at all, and that is precisely the silent mismatch this project
# refuses to make possible. They travel together or they do not travel.
#
# The service starts `degraded` when the mount is missing, says so on `/health`, and answers
# 503 on `/chat`. It does not invent an index.

USER 10001:10001

EXPOSE 8001

# Same reasoning as the model image: liveness, not readiness. It matters more here, because
# the copilot's build is the slower of the two - registry artefact, embedding model and
# Chroma index - so the window in which a readiness-shaped healthcheck would restart the
# service is correspondingly wider.
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import os,sys,urllib.request; sys.exit(0 if urllib.request.urlopen(f\"http://127.0.0.1:{os.environ['AGENT_API_PORT']}/health\", timeout=4).status == 200 else 1)"]

CMD ["sh", "-c", "exec uvicorn credit_copilot.api.agent_app:app --host 0.0.0.0 --port ${AGENT_API_PORT}"]
