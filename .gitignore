# --- Entornos virtuales -----------------------------------------------------
.venv/
venv/
env/
ENV/
.env

# --- Cachés y artefactos de Python -----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Cachés de herramientas -------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Credenciales -----------------------------------------------------------
.env
.env.*
!.env.example

# --- Experimentos -----------------------------------------------------------
mlruns/
mlartifacts/
# El backend SQLite que MLflow crea cuando la URI de seguimiento apunta a un archivo local.
# El seguimiento de este proyecto es REMOTO, así que este archivo solo aparece por accidente:
# con la variable de entorno sin definir, el cliente cae al almacén local por defecto y lo
# crea sin decir nada. Se ignora para que ese accidente no pueda además entrar al repositorio.
mlflow.db

# --- Datos: se ignora todo el contenido salvo los .gitkeep ------------------
data/**
!data/**/
!data/**/.gitkeep

# El corpus normativo SÍ se versiona: son documentos de texto, pesan poco, y sin
# ellos el índice vectorial no es reproducible. El índice, en cambio, es derivado.
!data/corpus/**
data/vector_store/

# El set de evaluación del retrieval también se versiona: las anotaciones se hicieron
# a mano y sin ellas ninguna medición de recuperación es reproducible ni auditable.
!data/eval/**

# --- Notebooks --------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- IDE / editores ---------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo

# --- Sistema operativo ------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
