# Copy to `.env` and fill in. `.env` is gitignored and never enters a Docker image:
# `.dockerignore` keeps it out of the build context, and `docker/docker-compose.yml`
# passes these values as runtime environment variables instead.

# Anthropic API key, used by the agentic copilot (GenAI phase).
# Only the agent service needs it. The model service never reads it.
ANTHROPIC_API_KEY=

# URI of the MLflow tracking server (local or remote) where runs are recorded.
# Both services need it: each loads the pinned production artefact from the registry.
MLFLOW_TRACKING_URI=

# Username to authenticate against the MLflow server, if it requires credentials.
MLFLOW_TRACKING_USERNAME=

# Password to authenticate against the MLflow server, if it requires credentials.
MLFLOW_TRACKING_PASSWORD=

# --- Only used by docker/docker-compose.yml ------------------------------------------
# Host ports the two services are published on. Change them when something else on the
# machine already listens there; the ports inside the containers do not move.
MODEL_API_HOST_PORT=8000
AGENT_API_HOST_PORT=8001
