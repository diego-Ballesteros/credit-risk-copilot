# Clave de la API de Anthropic, usada por el copiloto agentico (fase GenAI).
ANTHROPIC_API_KEY=

# URI del servidor de tracking de MLflow (local o remoto) donde se registran los runs.
MLFLOW_TRACKING_URI=

# Usuario para autenticarse contra el servidor de MLflow, si requiere credenciales.
MLFLOW_TRACKING_USERNAME=

# Password para autenticarse contra el servidor de MLflow, si requiere credenciales.
MLFLOW_TRACKING_PASSWORD=
